{
    "name": "web-best-practice/cookies",
    "description": "Laravel cookie consent (UK GDPR), Consent Mode v2, GA4/GTM, and custom scripts",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Web Best Practice",
            "email": "marcin@webbestpractice.co.uk"
        }
    ],
    "require": {
        "php": "^8.0|^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebBestPractice\\Cookies\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebBestPractice\\Cookies\\CookiesServiceProvider"
            ],
            "aliases": {
                "Analytics": "WebBestPractice\\Cookies\\Facades\\Analytics"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
